# RSC03 Multi-Agent System - Environment Variables
# Copy this file to .env and add your actual API keys

# OpenAI API (for GPT-4, GPT-3.5-turbo)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google AI API (for Gemini Pro)
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek API (for DeepSeek Coder)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Model configuration overrides
# DEFAULT_MODEL=gpt-3.5-turbo
# FALLBACK_MODEL=gpt-3.5-turbo

# Optional: Cost and rate limiting
# MAX_REQUESTS_PER_MINUTE=60
# COST_ALERT_THRESHOLD=10.00

# Optional: Logging level
# LOG_LEVEL=INFO