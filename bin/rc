#!/usr/bin/env python3
"""
RC - RSC03 Multi-Agent Command Interface
Executable wrapper for the RC command system
"""

import sys
import os
from pathlib import Path

# Add the RSC03 directory to Python path
rsc03_dir = Path(__file__).parent.parent
sys.path.insert(0, str(rsc03_dir))

# Change to RSC03 directory for proper context
os.chdir(rsc03_dir)

# Import and run the RC command
try:
    from rc import main
    if __name__ == '__main__':
        main()
except ImportError as e:
    print(f"❌ Error: Could not import RC command system: {e}")
    print(f"   Make sure you're running from the RSC03 directory: {rsc03_dir}")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running RC command: {e}")
    sys.exit(1)