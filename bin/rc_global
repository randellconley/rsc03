#!/usr/bin/env python3
"""
RC - RSC03 Multi-Agent Command Interface (Global Version)
Global wrapper that can be installed anywhere and still work
"""

import sys
import os
from pathlib import Path

# RSC03 installation directory (hardcoded for this installation)
RSC03_DIR = Path("/home/ubuntu/environment/workbench/rsc03")

# Add RSC03 directory to Python path
sys.path.insert(0, str(RSC03_DIR))

# Change to RSC03 directory for proper context and imports
original_cwd = os.getcwd()
os.chdir(RSC03_DIR)

# Import and run the RC command
try:
    from rc import main
    if __name__ == '__main__':
        main()
except ImportError as e:
    print(f"❌ Error: Could not import RC command system: {e}")
    print(f"   Make sure RSC03 is properly installed at {RSC03_DIR}")
    sys.exit(1)
except Exception as e:
    print(f"❌ Error running RC command: {e}")
    sys.exit(1)
finally:
    # Restore original working directory
    os.chdir(original_cwd)